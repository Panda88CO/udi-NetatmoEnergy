<nodeDefs>
  <nodeDef id="CONTROLLER" nls="CTL">
    <editors />
    <sts>
      <st id="ST" editor="CONNECT" />
    </sts>
    <cmds>
      <sends />
      <accepts>
        <cmd id="UPDATE" /> 
      </accepts>
    </cmds>
  </nodeDef>

  <nodeDef id="ROOM" nls="NROOM">
    <sts>
      <st id="ST" editor="CONNECT" />
      <st id="CLITEMP" editor="TEMPERATURE" />
      <st id="CLISPH" editor="TEMPERATURE" />
      <st id="CLIMD" editor="TCTRLMODE" />
      <st id="GV0" editor="ENERGYREQ" />
      <st id="GV1" editor="BOOL" />
      <st id="GV2" editor="BOOL" />
      <st id="GV3" editor="TTIMESTAMP" />     
    </sts>
    <cmds>
      <sends />
      <accepts>
        <cmd id="UPDATE" />  
        <cmd id="SETPOINT" >
              <p id="STEMP" editor="SETTEMP" init="CLISPH"/>             
               <p id="SPMODE" editor="THMODE" init="0" /> 
               <p id="ACTIVET" editor="TMIN" init="0" />   

        </cmd>      
        <cmd id="OPMODE" >
                <p id="OPMODE" editor="SETCLIMD" init="CLIMD"/> 
                <p id="ACTIVET" editor="TMIN" init="0" />   
        </cmd>          
</accepts>
    </cmds>
  </nodeDef>

  <nodeDef id="VALVE" nls="NVALVE">
    <sts>
      <st id="ST" editor="CONNECT" />
      <st id="GV0" editor="BATTERY" />
      <st id="GV1" editor="RFSTRENGTH" />
      <st id="GV2" editor="BATVALUE" />
    </sts>
    <cmds>
      <sends />
      <accepts> 
        <cmd id="UPDATE" />        
      </accepts>
    </cmds>
  </nodeDef>

  

</nodeDefs>
